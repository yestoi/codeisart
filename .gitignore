.venv/
__pycache__/
*.pyc
*.egg-info/
*.swp
*.swo
.DS_Store

# arcade operator: Stop-hook block counter and the commit it counts from (reset by the loop)
docs/superpowers/workflow/.blocks
docs/superpowers/workflow/.blocks-head

# worktrees of parallel implementers (Agent tool, isolation: worktree)
/.claude/worktrees/

# arcade: pose model, runtime data, contact sheets (anchored: tests/arcade/fixtures/ may hold data/ dirs)
/models/
/models
/data/
/shots/

# show daemon: entry build products stay local; sources, entry.toml and fallback casts are tracked
entries/*/*
!entries/*/*.c
!entries/*/entry.toml
!entries/*/fallback.cast
!entries/*/*.sh
!entries/*/LICENSE.md
entries/endoh3/clock.c

# operator evidence: images stay on the machine that made them, text is tracked (owner decision Q98, 2026-10-01;
# the images of it01 to it15 and hardware/ were tracked before it and stay tracked)
docs/superpowers/workflow/evidence/**/*.png
docs/superpowers/workflow/evidence/**/*.gif
docs/superpowers/workflow/evidence/**/*.jpg

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# local secrets
.env

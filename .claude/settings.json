{
  "hooks": {
    "PreCompact": [
      { "matcher": "auto|manual",
        "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/operator/precompact.py\"", "timeout": 10 } ] }
    ],
    "SessionStart": [
      { "matcher": "compact",
        "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/operator/reinject.py\"", "timeout": 10 } ] },
      { "matcher": "startup|resume",
        "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/operator/reinject.py\" --fresh", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/operator/stop.py\"", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/operator/guard_bash.py\"", "timeout": 5 } ] },
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/operator/guard_write.py\"", "timeout": 5 } ] }
    ]
  }
}
